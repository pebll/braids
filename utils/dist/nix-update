#
# Points the Nix package (flake.nix, nix/package.nix) at a published
# release: writes its version and the tarballs' checksums (the release's
# .sha256 files) to nix/release.json. The release workflow runs it after
# publishing and commits the result to main.
#
#   utils/dist/nix-update [version]     # default: the latest release

set -euo pipefail

REPO="pebll/braids"
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

VERSION="${1:-}"
if [[ -z "${VERSION}" ]]; then
  VERSION="$(curl -fsSL "https://api.github.com/repos/${REPO}/releases/latest" | sed -n 's/.*"tag_name": *"v\{0,1\}\([^"]*\)".*/\1/p' | head -1)"
fi
VERSION="${VERSION#v}"
[[ -n "${VERSION}" ]] || { echo "nix-update: no version" >&2; exit 1; }

sha() {
  local sum
  sum="$(curl -fsSL "https://github.com/${REPO}/releases/download/v${VERSION}/braids-linux-${1}.tar.gz.sha256" | cut -d' ' -f1)"
  [[ "${sum}" =~ ^[0-9a-f]{64}$ ]] || { echo "nix-update: no checksum for ${1} in v${VERSION}" >&2; exit 1; }
  echo "${sum}"
}

X86_64="$(sha x86_64)"
AARCH64="$(sha aarch64)"
cat > "${ROOT}/nix/release.json" <<EOF
{
  "version": "${VERSION}",
  "sha256": {
    "x86_64": "${X86_64}",
    "aarch64": "${AARCH64}"
  }
}
EOF
echo "nix/release.json: braids ${VERSION}"
